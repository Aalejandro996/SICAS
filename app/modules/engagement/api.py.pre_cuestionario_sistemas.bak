# Compatibilidad: la antigua ruta /return ahora enruta la devolución según la etapa.
@bp.post("/reports/<uuid:rid>/return")
@permission_required("audit:report_approve_jefe", "audit:report_approve_gerente", "audit:report_approve", step_up=True)
def return_report(rid):
    rep, a, team, e = get_rep(rid)
    if e:
        return e
    st = _state(rep, team)
    p = perms()
    if rep["status"] == "IN_REVIEW" and "audit:report_approve_jefe" in p:
        return jefe_return(rid)
    if rep["status"] == "GERENCIA" and "audit:report_approve_gerente" in p:
        return gerente_return(rid)
    if rep["status"] == "CONTRALOR" and "audit:report_approve" in p:
        return contralor_return(rid)
    return err("El informe no está en una etapa que pueda devolver su rol", 409)


@bp.post("/reports/<uuid:rid>/approve")
@permission_required("audit:report_approve", step_up=True)
def approve(rid):
    # Compatibilidad con clientes antiguos: la aprobación del Contralor deja el informe
    # en etapa de firma, pero el flujo nuevo recomienda /approve-sign/contralor.
    rep, a, team, e = get_rep(rid)
    if e:
        return e
    try:
        wf.can_contralor_review(_state(rep, team), me())
    except wf.WorkflowError as ex:
        return err(str(ex), 409)
    repo.set_report_status(rid, "APPROVED", approved_by=me(), approved_at="now", approved_body_sha256=rep["body_sha256"],
                           contralor_approved_by=me(), contralor_approved_at="now", contralor_approved_body_sha256=rep["body_sha256"])
    log("AUDIT_REPORT_APPROVED", entity_type="audit_report", entity_id=str(rid), after_data={"sha256": rep["body_sha256"], "legacy_route": True}, request_id=g.request_id)
    return jsonify(status="APPROVED", note="Use la opción Firmar y aprobar como Contralor para completar el flujo nuevo.")



def _sign(rid, role, approve_too=False):
    from app.modules.reporting.signing import service as signing
    rep, a, team, e = get_rep(rid, final_viewer=True)
    if e:
        return e
    st = _state(rep, team)
    try:
        wf.can_sign(st, me(), role)
        if role == "GERENTE_CI" and approve_too:
            wf.can_gerente_review(st, me())
        if role == "CONTRALOR" and approve_too:
            wf.can_contralor_review(st, me())
    except wf.WorkflowError as ex:
        log("AUDIT_REPORT_SIGN_REJECTED", outcome="DENIED", entity_type="audit_report", entity_id=str(rid), metadata={"role": role, "reason": str(ex)}, request_id=g.request_id)
        return err(str(ex), 409)

    docs = repo.signed_docs(rid)
    current_docs = [d for d in docs if d.get("sha256_unsigned") == rep["body_sha256"]]
    if any(d["signer_role"] == role for d in current_docs):
        return err(f"La firma de {role} ya existe para el contenido actual", 409)

    cfg = current_app.config
    version = (max((int(d["version"]) for d in docs), default=0) + 1)
    try:
        if role == "GERENTE_CI":
            base = _pdf_for(rep, team)
            box, field, label = SIG_BOX_GERENTE, "FirmaGerenteCI", "Gerente"
        else:
            manager = next((d for d in reversed(current_docs) if d["signer_role"] == "GERENTE_CI"), None)
            if not manager:
                raise ValueError("No existe una firma vigente de Gerencia para este contenido")
            base = storage.get(manager["object_key"])
            box, field, label = SIG_BOX_CONTRALOR, "FirmaContralor", "Contralor"
        signed = signing.sign_pdf(
            base, signing.load_signer(cfg, role),
            reason=f"Informe de auditoría {a['code']} — {label}",
            location=cfg.get("SIGNING_LOCATION", "Venezuela"),
            signer_name=g.claims.get("username", me()), field_name=field, box=box, tsa_url=cfg.get("TSA_URL")
        )
        key = f"reports/{rid}/v{version}.pdf"
        storage.put(key, signed.pdf_bytes)
    except Exception as ex:  # noqa: BLE001
        log("AUDIT_REPORT_SIGN_FAILED", outcome="FAILURE", entity_type="audit_report", entity_id=str(rid), metadata={"role": role, "error": type(ex).__name__}, request_id=g.request_id)
        return err("No fue posible firmar el documento" + (f" ({ex})" if cfg.get("ENV") == "dev" else ""), 500)

    try:
        repo.add_signed_doc(rid, role, version, signed, key, me())
        if approve_too:
            if role == "GERENTE_CI":
                repo.set_report_status(rid, "CONTRALOR", gerente_approved_by=me(), gerente_approved_at="now", gerente_approved_body_sha256=rep["body_sha256"])
            else:
                repo.set_report_status(rid, "SIGNED", approved_by=me(), approved_at="now", approved_body_sha256=rep["body_sha256"],
                                       contralor_approved_by=me(), contralor_approved_at="now", contralor_approved_body_sha256=rep["body_sha256"])
        else:
            # Compatibilidad con las rutas antiguas de firma.
            if role == "GERENTE_CI":
                repo.set_report_status(rid, "CONTRALOR", gerente_approved_by=me(), gerente_approved_at="now", gerente_approved_body_sha256=rep["body_sha256"])
            elif wf.is_fully_signed(st):
                repo.set_report_status(rid, "SIGNED")
    except Exception as ex:  # noqa: BLE001
        log("AUDIT_REPORT_SIGN_REGISTER_FAILED", outcome="FAILURE", entity_type="audit_report", entity_id=str(rid), metadata={"role": role, "error": type(ex).__name__}, request_id=g.request_id)
        return err("La firma fue generada pero no pudo registrarse en SICAS; contacte al administrador", 500)

    log("AUDIT_REPORT_SIGNED", entity_type="audit_report", entity_id=str(rid), after_data={"role": role, "sha256_signed": signed.sha256_signed, "cert_serial": signed.cert_serial, "approved_together": approve_too}, request_id=g.request_id)
    return jsonify(status="SIGNED" if role == "CONTRALOR" and approve_too else "CONTRALOR", signed_by=role, approved_together=approve_too, timestamp_embedded=signed.timestamp_embedded)



@bp.post("/reports/<uuid:rid>/sign/contralor")
@permission_required("audit:sign_contralor", step_up=True)
def sign_contralor(rid):
    return _sign(rid, "CONTRALOR")


@bp.post("/reports/<uuid:rid>/sign/gerente")
@permission_required("audit:sign_gerente", step_up=True)
def sign_gerente(rid):
